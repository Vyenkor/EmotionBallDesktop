<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Emotionball-Deskpet-Setup</AssemblyName>
    <RootNamespace>EmotionballDeskpet.Setup</RootNamespace>
    <Version>1.0.0</Version>
    <ApplicationIcon>..\desktop-host\Assets\EmotionBall.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup Condition="'$(PayloadZip)' != '' and Exists('$(PayloadZip)')">
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="Emotionball-Deskpet.Payload.zip" />
  </ItemGroup>
</Project>
