<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Emotionball-Deskpet</AssemblyName>
    <RootNamespace>EmotionballDeskpet</RootNamespace>
    <Version>1.0.4</Version>
    <Authors>Vyenkor; sam70361 (upstream)</Authors>
    <Description>Unofficial Windows desktop derivative of emotion-ball with Codex and local app status integration.</Description>
    <RepositoryUrl>https://github.com/Vyenkor/Emotionball-Deskpet</RepositoryUrl>
    <ApplicationIcon>Assets\EmotionBall.ico</ApplicationIcon>
    <BundlePrivateFonts Condition="'$(BundlePrivateFonts)' == ''">false</BundlePrivateFonts>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Fonts\PingFangSC-Medium.ttf" Condition="'$(BundlePrivateFonts)' == 'true' and Exists('Fonts\PingFangSC-Medium.ttf')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Fonts\PingFangSC-Semibold.ttf" Condition="'$(BundlePrivateFonts)' == 'true' and Exists('Fonts\PingFangSC-Semibold.ttf')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <Target Name="RemoveUnusedWebView2WpfAssembly" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
</Project>
